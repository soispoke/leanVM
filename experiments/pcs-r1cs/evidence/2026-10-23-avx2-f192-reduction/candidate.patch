     use crate::field::gf2_64::R64;
     use crate::test_rng::Rng;
 
+    #[test]
+    fn reduction_matches_scalar_for_all_coefficient_bits() {
+        let scalar = |u: F192Unreduced| {
+            let c = u
+                .coeffs
+                .map(|[lo, hi]| crate::field::gf2_64::reduce((u128::from(hi) << 64) | u128::from(lo)));
+            F192::new(c[0], c[1], c[2])
+        };
+        for bit in 0..384 {
+            let mut u = F192Unreduced::ZERO;
+            u.coeffs[bit / 128][bit / 64 % 2] = 1 << (bit % 64);
+            assert_eq!(u.reduce(), scalar(u), "basis bit={bit}");
+        }
+        let mut rng = Rng::new(0xdecaf20261023);
+        for _ in 0..10_000 {
+            let u = F192Unreduced {
+                coeffs: core::array::from_fn(|_| [rng.next_u64(), rng.next_u64()]),
+            };
+            assert_eq!(u.reduce(), scalar(u));
+        }
+        for word in [0, u64::MAX, 1 << 63, 1] {
+            let u = F192Unreduced { coeffs: [[word; 2]; 3] };
+            assert_eq!(u.reduce(), scalar(u));
+        }
+    }
