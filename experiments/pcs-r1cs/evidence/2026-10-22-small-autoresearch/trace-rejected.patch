+fn copy_bits(source: [u64; 3], mut from: usize, dest: &mut [u64; 3], mut to: usize, mut len: usize) {
+    while len != 0 {
+        let count = len.min(64 - from % 64).min(64 - to % 64);
+        let mask = u64::MAX >> (64 - count);
+        dest[to / 64] |= ((source[from / 64] >> (from % 64)) & mask) << (to % 64);
+        from += count;
+        to += count;
+        len -= count;
+    }
+}
