+/// RFC 7693 compression primitive. `t` counts bytes; `f0` and `f1` are
+/// the low and high finalization masks, XORed into v[14] and v[15].
+/// Ordinary sequential BLAKE2s uses f0=0xffffffff only for its final block
+/// and f1=0. No key or parameter initialization is applied here.
+pub fn blake2s_compress(h: &[u32; 8], m: &[u32; 16], t: u64, f0: u32, f1: u32) -> [u32; 8] {
+    let mut state = [0u32; 16];
+    state[..8].copy_from_slice(h);
+    state[8..].copy_from_slice(&BLAKE2S_IV);
+    state[12] ^= t as u32;
+    state[13] ^= (t >> 32) as u32;
+    state[14] ^= f0;
+    state[15] ^= f1;
+    for schedule in BLAKE2S_SIGMA {
+        let block = std::array::from_fn(|i| m[schedule[i]]);
+        blake3_round(&mut state, &block); // The ARX G function is identical.
+    }
+    std::array::from_fn(|i| h[i] ^ state[i] ^ state[i + 8])
+}
+
+/// RFC 7693 unkeyed sequential BLAKE2s with a 256-bit output.
+pub fn blake2s256(message: &[u8]) -> Digest {
+    let mut h = BLAKE2S_IV;
+    h[0] ^= 0x0101_0020;
+    let nblocks = message.len().max(1).div_ceil(64);
+    for index in 0..nblocks {
+        let start = index * 64;
+        let end = (start + 64).min(message.len());
+        let mut block = [0u8; 64];
+        block[..end - start].copy_from_slice(&message[start..end]);
+        let words = std::array::from_fn(|i| {
+            u32::from_le_bytes(block[4 * i..4 * i + 4].try_into().unwrap())
+        });
+        let last = index + 1 == nblocks;
+        h = blake2s_compress(&h, &words, end as u64, if last { u32::MAX } else { 0 }, 0);
+    }
+    let mut out = [0u8; 32];
+    for (word, dst) in h.iter().zip(out.chunks_exact_mut(4)) {
+        dst.copy_from_slice(&word.to_le_bytes());
+    }
+    out
+}
