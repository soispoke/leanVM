+            let cv = match link.cv {
+                CvSource::Iv => IV,
+                CvSource::Row(r) => {
+                    assert!(r < i);
+                    outputs[r]
+                }
+                CvSource::RowHi(_) => {
+                    panic!("physical trace must never consume compatibility zero outputs")
+                }
+            };
+            assert_eq!(trace.rows[i].0, cv, "row {i}");
+        }
+        assert_eq!(trace.squeeze_words.len(), expected.len());
+        for (k, sources) in trace.squeeze_words.iter().enumerate() {
+            let mut got = Vec::new();
+            for &(row, w) in sources {
+                assert!(w < 2);
+                for v in &outputs[row][w * 4..w * 4 + 4] {
