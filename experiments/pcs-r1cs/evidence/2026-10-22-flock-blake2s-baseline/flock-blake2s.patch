+        let mut expected = Vec::new();
+        for i in 0..24u64 {
+            rec.observe_f128(F128::new(i, i * 19));
+            let words = if i % 3 == 0 {
+                rec.grind_pow_and_sample_f128_vec(4, 9).1
+            } else {
+                rec.sample_f128_vec(3)
+            };
+            let mut bytes = Vec::new();
+            for v in words {
+                bytes.extend_from_slice(&v.lo.to_le_bytes());
+                bytes.extend_from_slice(&v.hi.to_le_bytes());
+            }
+            expected.push(bytes);
+        }
+        let shape = rec.shape();
+        let stream = shape.stream_words_duplex(domain);
+        let bytes = stream.to_bytes(rec.values(), rec.payloads());
+        let trace = trace_duplex_blake2s(&stream, &bytes, shape.ops());
