+/// Expand virtual 512-bit compression outputs into two actual BLAKE2s
+/// compression rows. The second row repeats the same CV/message with a
+/// disjoint f1 output-half domain. Its output is unconstrained by neither a
+/// native assertion nor a zero slot: it is a full constrained compression.
+fn expand_blake2s_trace(trace: FsChainTrace) -> FsChainTrace {
+    fn source(cv: CvSource) -> CvSource {
+        match cv {
+            CvSource::Iv => CvSource::Iv,
+            CvSource::Row(r) => CvSource::Row(2 * r),
+            CvSource::RowHi(r) => CvSource::Row(2 * r + 1),
+        }
+    }
+    let mut rows = Vec::with_capacity(2 * trace.rows.len());
+    let mut links = Vec::with_capacity(rows.capacity());
+    let mut block_offsets = Vec::with_capacity(rows.capacity());
+    let mut block_word_counts = Vec::with_capacity(rows.capacity());
+    for (i, &(cv, m, t, f0, f1)) in trace.rows.iter().enumerate() {
+        assert_eq!(f1 & (1 << 31), 0);
+        let link = trace.links[i];
+        assert!(
+            link.right.is_none() && link.repeats.is_none(),
+            "duplex only"
+        );
+        for domain in [f1, f1 | (1 << 31)] {
+            rows.push((cv, m, t, f0, domain));
+            links.push(Link {
+                cv: source(link.cv),
+                right: None,
+                repeats: None,
+            });
+            block_offsets.push(trace.block_offsets[i]);
+            block_word_counts.push(trace.block_word_counts[i]);
         }
     }
+    FsChainTrace {
+        rows,
+        links,
+        block_offsets,
+        block_word_counts,
+        squeezes: trace
+            .squeezes
+            .into_iter()
+            .map(|ids| ids.into_iter().flat_map(|r| [2 * r, 2 * r + 1]).collect())
+            .collect(),
+        squeeze_words: trace
+            .squeeze_words
+            .into_iter()
+            .map(|words| {
+                words
+                    .into_iter()
+                    .map(|(r, w)| (2 * r + w / 2, w % 2))
+                    .collect()
+            })
+            .collect(),
+    }
 }
 
