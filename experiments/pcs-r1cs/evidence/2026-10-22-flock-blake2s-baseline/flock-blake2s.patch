diff --git a/crates/flock-prover/examples/tower_blake2s.rs b/crates/flock-prover/examples/tower_blake2s.rs
new file mode 100644
index 0000000..a7a9b11
--- /dev/null
+++ b/crates/flock-prover/examples/tower_blake2s.rs
@@ -0,0 +1,111 @@
+//! Full upstream Flock tower adapted to BLAKE2s, not a compression microbenchmark.
+//! Build with --features blake2s-tower. The independent consumer verifier is mandatory.
+use flock_prover::tower::{Tower, TowerConfig, TowerVk, verify_root_bytes};
+use std::{env, time::Instant};
+fn main() {
+    assert!(
+        cfg!(feature = "blake2s-tower"),
+        "requires --features blake2s-tower"
+    );
+    let mut args = env::args().skip(1);
+    let leaves: usize = args.next().map_or(8, |s| s.parse().expect("leaves"));
+    let blocks: usize = args.next().map_or(256, |s| s.parse().expect("blocks"));
+    let repeats: usize = args.next().map_or(1, |s| s.parse().expect("repeat count"));
+    assert!(repeats > 0, "repeat count positive");
+    assert!(
+        args.next().is_none(),
+        "usage: tower_blake2s [even leaves>=4] [power-of-two blocks] [repeats]"
+    );
+    let cfg = TowerConfig::Chain128;
+    let start = Instant::now();
+    let vk = TowerVk::generate(cfg, blocks);
+    let vk_setup_ms = start.elapsed().as_secs_f64() * 1000.;
+    println!(
+        "{{\"record\":\"shared_vk_setup\",\"vk_setup_ms\":{},\"trials\":{},\"same_process\":true,\"excluded_warmups\":0,\"policy\":\"one independently generated immutable VK; full Tower::prove per trial\"}}",
+        vk_setup_ms, repeats
+    );
+    for trial in 0..repeats {
+        let start = Instant::now();
+        let tower = Tower::prove(cfg, [0; 16], blocks, leaves);
+        let full_prove_ms = start.elapsed().as_secs_f64() * 1000.;
+        for t in tower.stage_timings() {
+            println!(
+                "{{\"record\":\"stage\",\"trial\":{},\"kind\":\"{}\",\"ordinal\":{},\"builder_call_ms_including_setup_and_self_checks\":{},\"setup_ms\":{},\"walk_ms\":{},\"tapes_ms\":{},\"witgen_ms\":{},\"prove_ms\":{},\"replica_checks_ms\":{},\"accumulator_self_discharge_ms\":{},\"builder_verify_ms\":{},\"online_wall_ms\":{},\"proof_bytes\":{}}}",
+                trial,
+                t.kind,
+                t.ordinal,
+                t.call_ms,
+                t.setup_ms,
+                t.walk_ms,
+                t.tapes_ms,
+                t.witgen_ms,
+                t.prove_ms,
+                t.replica_checks_ms,
+                t.accumulator_self_discharge_ms,
+                t.verify_ms,
+                t.wall_ms,
+                t.proof_bytes
+            );
+        }
+        let start = Instant::now();
+        tower.discharge_root().expect("root discharge");
+        let discharge_ms = start.elapsed().as_secs_f64() * 1000.;
+        let bytes = tower.root_bundle_bytes();
+        let start = Instant::now();
+        let statement =
+            verify_root_bytes(&vk, &bytes).expect("serialized root standalone verifies");
+        let verify_ms = start.elapsed().as_secs_f64() * 1000.;
+        assert_eq!(&statement, tower.statement());
+        println!(
+            "{{\"record\":\"statement\",\"trial\":{},\"h_start\":{:?},\"h_end\":{:?},\"total_compressions\":{}}}",
+            trial, statement.h_start, statement.h_end, statement.n_blocks
+        );
+        // These are actual consumer-path rejects, not prover self-checks.
+        assert!(
+            verify_root_bytes(&vk, &bytes[..bytes.len() - 1]).is_err(),
+            "truncated root accepted"
+        );
+        let mut bad = bytes.clone();
+        bad[0] ^= 1;
+        assert!(verify_root_bytes(&vk, &bad).is_err(), "bad header accepted");
+        let mut bad = bytes.clone();
+        let last = bad.len() - 1;
+        bad[last] ^= 1;
+        assert!(
+            verify_root_bytes(&vk, &bad).is_err(),
+            "mutated root accepted"
+        );
+        let original = flock_prover::proof_io::TowerRootBundle::from_bytes(&bytes)
+            .expect("honest bundle parses");
+        for mutation in 0..6 {
+            let mut bad = original.clone();
+            match mutation {
+                0 => bad.statement.h_start[0] ^= 1,
+                1 => bad.statement.h_end[0] ^= 1,
+                2 => bad.statement.n_blocks += 2 * blocks,
+                3 => {
+                    bad.public[0] += flock_field::F128::ONE;
+                }
+                4 => bad.commitment.cap[0][0] ^= 1,
+                5 => bad.blocks_per_leaf += 1,
+                _ => unreachable!(),
+            }
+            assert!(
+                verify_root_bytes(&vk, &bad.to_bytes()).is_err(),
+                "semantic mutation {mutation} accepted"
+            );
+        }
+        println!(
+            "{{\"record\":\"summary\",\"trial\":{},\"construction\":\"succinct-flock-blake2s-adaptation\",\"profile\":\"Chain128\",\"statement\":\"sequential-BLAKE2s256-on-64-byte-state-output-zero-extended\",\"leaves\":{},\"blocks_per_leaf\":{},\"total_compressions\":{},\"full_prove_ms_including_setup\":{},\"root_discharge_ms\":{},\"consumer_verify_ms\":{},\"proof_bytes\":{},\"bundle_bytes\":{},\"mutation_rejections\":9,\"verified\":true}}",
+            trial,
+            leaves,
+            blocks,
+            leaves * blocks,
+            full_prove_ms,
+            discharge_ms,
+            verify_ms,
+            (tower.root_proof_kib() * 1024.) as usize,
+            bytes.len()
+        );
+    }
+}
