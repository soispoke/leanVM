+    #[test]
+    fn tampered_outputs_params_and_helpers_rejected() {
+        let input = ([0x12345678; 8], [0xabcdef01; 16], 1u64 << 40, u32::MAX, 0);
+        let (a, b) = shared_matrices();
+        let z = build_block_witness(&input.0, &input.1, input.2, input.3, input.4);
+        let holds = |z: &[bool]| {
+            (0..K).all(|row| {
+                let av = a.rows[row].iter().fold(false, |x, &i| x ^ z[i]);
+                let bv = b.rows[row].iter().fold(false, |x, &i| x ^ z[i]);
+                (av & bv) == z[row]
+            })
+        };
+        assert!(holds(&z));
+        for index in [
+            CV_BASE,
+            M_BASE,
+            T_LO_BASE,
+            T_HI_BASE,
+            F0_BASE,
+            F1_BASE,
+            OUT_LO_BASE,
+            OUT_HI_BASE,
+            GS_BASE,
+        ] {
+            let mut bad = z.clone();
+            bad[index] ^= true;
+            assert!(!holds(&bad), "tampered bit {index} accepted");
+        }
+    }
+}
