@@ -0,0 +1,204 @@
+//! Hash selection for the explicitly versioned BLAKE2s tower adaptation.
+//! The default build retains the upstream BLAKE3 construction unchanged.
+#[cfg(feature = "blake2s-tower")]
+pub(super) use crate::r1cs_hashes::blake2s::{
+    Compression, build_block_r1cs, generate_witness_batch_major_partial,
+    generate_witness_batch_major_partial_into, io_schema,
+};
+#[cfg(not(feature = "blake2s-tower"))]
+pub(super) use crate::r1cs_hashes::blake3::{
+    Compression, build_block_r1cs, generate_witness_batch_major_partial,
+    generate_witness_batch_major_partial_into, io_schema,
+};
+#[cfg(not(feature = "blake2s-tower"))]
+pub(super) use flock_hash::blake3_compress as compress;
+#[cfg(feature = "blake2s-tower")]
+pub(super) fn compress(cv: &[u32; 8], m: &[u32; 16], t: u64, f0: u32, f1: u32) -> [u32; 16] {
+    let mut out = [0u32; 16];
+    out[..8].copy_from_slice(&flock_hash::blake2s_compress(cv, m, t, f0, f1));
+    out
+}
+pub(super) const KIND: flock_merkle::HashKind = if cfg!(feature = "blake2s-tower") {
+    flock_merkle::HashKind::Blake2s
+} else {
+    flock_merkle::HashKind::Blake3
+};
+pub(super) fn challenger(domain: &[u8]) -> crate::challenger::FsChallenger {
+    #[cfg(feature = "blake2s-tower")]
+    {
+        crate::challenger::FsChallenger::with_chained_blake2s(domain)
+    }
+    #[cfg(not(feature = "blake2s-tower"))]
+    {
+        crate::challenger::FsChallenger::with_chained_blake3(domain)
+    }
+}
+pub(super) fn initial_iv(personal: Option<&[u8; 8]>) -> [u32; 8] {
+    #[allow(unused_mut)]
+    let mut iv = super::gates_blake3::IV;
+    #[cfg(feature = "blake2s-tower")]
+    {
+        iv[0] ^= 0x01010020;
+        if let Some(personal) = personal {
+            iv[6] ^= u32::from_le_bytes(personal[..4].try_into().unwrap());
+            iv[7] ^= u32::from_le_bytes(personal[4..].try_into().unwrap());
+        }
+    }
+    #[cfg(not(feature = "blake2s-tower"))]
+    let _ = personal;
+    iv
+}
+#[cfg(feature = "blake2s-tower")]
+pub(super) fn hash_params(
+    bytes: usize,
+    final_block: bool,
+    first: bool,
+    parent: bool,
+) -> super::F128 {
+    #[cfg(feature = "blake2s-tower")]
+    {
+        let _ = (first, parent);
+        super::pack_params(bytes as u64, if final_block { u32::MAX } else { 0 }, 0)
+    }
+    #[cfg(not(feature = "blake2s-tower"))]
+    {
+        super::pack_params(
+            0,
+            bytes as u32,
+            if parent {
+                super::PARENT
+            } else {
+                (if first { super::CHUNK_START } else { 0 })
+                    | (if final_block { super::CHUNK_END } else { 0 })
+            },
+        )
+    }
+}
+/// Hash an aligned word string under the standard BLAKE2s parameter block.
+/// Personalization occupies the standard eight-byte BLAKE2s parameter field.
+#[cfg(feature = "blake2s-tower")]
+pub(super) fn emit_hash(
+    sb: &mut super::ShapeBuilder,
+    slot: flock_core::circuit::builder::SlotId,
+    words: &[super::Wire],
+    personal: Option<&[u8; 8]>,
+    vals: &mut Vec<super::F128>,
+    consts: &mut Option<&mut Vec<(super::F128, super::Wire)>>,
+) -> [super::Wire; 2] {
+    fn shared(
+        sb: &mut super::ShapeBuilder,
+        vals: &mut Vec<super::F128>,
+        c: &mut Option<&mut Vec<(super::F128, super::Wire)>>,
+        v: super::F128,
+    ) -> super::Wire {
+        match c.as_deref_mut() {
+            Some(c) => super::cw(sb, vals, c, v),
+            None => {
+                vals.push(v);
+                sb.fixed_public_input(v)
+            }
+        }
+    }
+    assert!(!words.is_empty());
+    let p = super::pack8(&initial_iv(personal));
+    let mut cv = [
+        shared(sb, vals, consts, p[0]),
+        shared(sb, vals, consts, p[1]),
+    ];
+    let zero = shared(sb, vals, consts, super::F128::ZERO);
+    let blocks = words.len().div_ceil(4);
+    for (i, block) in words.chunks(4).enumerate() {
+        let mut m = [zero; 4];
+        m[..block.len()].copy_from_slice(block);
+        let params = shared(
+            sb,
+            vals,
+            consts,
+            hash_params(
+                ((i + 1) * 64).min(words.len() * 16),
+                i + 1 == blocks,
+                i == 0,
+                false,
+            ),
+        );
+        let out = sb.gate(slot, &[cv[0], cv[1], m[0], m[1], m[2], m[3], params]);
+        cv = [out[0], out[1]];
+    }
+    cv
+}
+
+#[cfg(all(test, feature = "blake2s-tower"))]
+mod tests {
+    use super::*;
+    use crate::tower::{Blake3Gate, F128, ShapeBuilder, hash_to_digest, pack8};
+    #[test]
+    fn blake2s_tower_hash_gadget_matches_native_personalized_hashes() {
+        for words in [1usize, 2, 3, 4, 5, 61, 64] {
+            let data: Vec<u8> = (0..words * 16).map(|i| (i * 17 + words) as u8).collect();
+            let mut sb = ShapeBuilder::new(5);
+            let slot = sb.slot(Blake3Gate { nu: 5 });
+            let mut vals: Vec<F128> = data
+                .chunks_exact(16)
+                .map(|b| {
+                    F128::new(
+                        u64::from_le_bytes(b[..8].try_into().unwrap()),
+                        u64::from_le_bytes(b[8..].try_into().unwrap()),
+                    )
+                })
+                .collect();
+            let input: Vec<_> = (0..words).map(|_| sb.input()).collect();
+            let out = emit_hash(
+                &mut sb,
+                slot,
+                &input,
+                Some(b"FlockLf0"),
+                &mut vals,
+                &mut Some(&mut Vec::new()),
+            );
+            sb.publish(out[0]);
+            sb.publish(out[1]);
+            let shape = sb.finish().expect("hash shape");
+            let witness = shape.run(&vals, &[]);
+            let expected = pack8(&hash_to_digest(&flock_merkle::blake2s_merkle_leaf(&data)));
+            assert_eq!(
+                &witness.public[witness.public.len() - 2..],
+                &expected,
+                "leafwords={words}"
+            );
+        }
+        let left = [7u8; 32];
+        let right = [93u8; 32];
+        let mut data = left.to_vec();
+        data.extend_from_slice(&right);
+        let mut sb = ShapeBuilder::new(3);
+        let slot = sb.slot(Blake3Gate { nu: 3 });
+        let mut vals: Vec<F128> = data
+            .chunks_exact(16)
+            .map(|b| {
+                F128::new(
+                    u64::from_le_bytes(b[..8].try_into().unwrap()),
+                    u64::from_le_bytes(b[8..].try_into().unwrap()),
+                )
+            })
+            .collect();
+        let inputs: Vec<_> = (0..4).map(|_| sb.input()).collect();
+        let out = emit_hash(
+            &mut sb,
+            slot,
+            &inputs,
+            Some(b"FlockNd0"),
+            &mut vals,
+            &mut Some(&mut Vec::new()),
+        );
+        sb.publish(out[0]);
+        sb.publish(out[1]);
+        let shape = sb.finish().unwrap();
+        let witness = shape.run(&vals, &[]);
+        assert_eq!(
+            &witness.public[witness.public.len() - 2..],
+            &pack8(&hash_to_digest(&flock_merkle::blake2s_merkle_parent(
+                &left, &right
+            )))
+        );
+    }
+}
