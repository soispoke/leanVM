+/// Standard RFC 7693 BLAKE2s-256 with an eight-byte personalization field.
+/// The IV parameter block binds leaf/parent domains without byte-shift gates.
+fn blake2s_personalized(data: &[u8], personal: &[u8; 8]) -> Hash {
+    let mut state = flock_hash::BLAKE2S_IV;
+    state[0] ^= 0x0101_0020;
+    state[6] ^= u32::from_le_bytes(personal[..4].try_into().unwrap());
+    state[7] ^= u32::from_le_bytes(personal[4..].try_into().unwrap());
+    let count = data.len().div_ceil(64).max(1);
+    for i in 0..count {
+        let start = i * 64;
+        let end = (start + 64).min(data.len());
+        let mut block = [0u8; 64];
+        block[..end - start].copy_from_slice(&data[start..end]);
+        let words = core::array::from_fn(|j| {
+            u32::from_le_bytes(block[4 * j..4 * j + 4].try_into().unwrap())
+        });
+        state = flock_hash::blake2s_compress(
+            &state,
+            &words,
+            end as u64,
+            if i + 1 == count { u32::MAX } else { 0 },
+            0,
+        );
+    }
+    let mut digest = [0u8; 32];
+    for (bytes, word) in digest.as_chunks_mut::<4>().0.iter_mut().zip(state) {
+        bytes.copy_from_slice(&word.to_le_bytes());
+    }
+    digest
