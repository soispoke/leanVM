+#[cfg(test)]
+mod blake2s_domain_tests {
+    use super::*;
+    #[test]
+    fn wide_output_has_two_real_disjoint_digests() {
+        let cv = BLAKE3_IV;
+        let m = [7u32; 16];
+        let out = blake2s_wide_compress(&cv, &m, 0, 48, CHAIN_SQUEEZE);
+        assert_eq!(&out[..8], &blake2s_compress(&cv, &m, 0, 48, CHAIN_SQUEEZE));
+        assert_eq!(
+            &out[8..],
+            &blake2s_compress(&cv, &m, 0, 48, CHAIN_SQUEEZE | (1 << 31))
+        );
+        assert_ne!(&out[..8], &out[8..]);
+        assert_ne!(&out[8..], &[0u32; 8]);
+        assert_ne!(out, blake2s_wide_compress(&cv, &m, 0, 32, CHAIN_SQUEEZE));
+        assert_ne!(out, blake2s_wide_compress(&cv, &m, 0, 48, CHAIN_ABSORB));
+    }
+    #[test]
+    fn fused_pow_binds_difficulty_nonce_and_continuation() {
+        let mut chain = B3Chain {
+            kind: HashKind::Blake2s,
+            ..B3Chain::new()
+        };
+        chain.absorb(&[1u8; 16]);
+        let p = chain.pow_candidate_output(4, 6);
+        assert_ne!(p, chain.pow_candidate_output(5, 6));
+        assert_ne!(p, chain.pow_candidate_output(4, 7));
+        let mut a = chain.clone();
+        let mut b = chain;
+        let mut ao = [0u8; 16];
+        let mut bo = [0u8; 16];
+        a.apply_pow_squeeze(4, 6, &mut ao);
+        b.apply_pow_squeeze(5, 6, &mut bo);
+        assert_ne!(a.cv, b.cv);
+        assert_eq!(a.cv, p[8..16]);
+    }
