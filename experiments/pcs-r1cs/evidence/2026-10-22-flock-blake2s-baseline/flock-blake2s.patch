+            let m = from_fn(|_| rng.next_u32());
+            let t = ((rng.next_u32() as u64) << 32) | rng.next_u32() as u64;
+            let f0 = rng.next_u32();
+            let f1 = rng.next_u32();
+            let z = build_block_witness(&cv, &m, t, f0, f1);
+            let expected = flock_hash::blake2s_compress(&cv, &m, t, f0, f1);
+            for w in 0..8 {
+                let got = (0..32).fold(0u32, |x, b| x | ((z[out_lo_bit(w, b)] as u32) << b));
+                assert_eq!(got, expected[w]);
+                assert!((0..32).all(|b| !z[out_hi_bit(w, b)]));
+            }
+        }
+        assert!(USEFUL_BITS <= K);
+    }
